# Postgres connection string. Against a pooled provider endpoint (PgBouncer) in production.
DATABASE_URL=postgres://taskeeper:taskeeper@localhost:5433/taskeeper
# Direct (unpooled) endpoint. Migrations use it because PgBouncer transaction pooling
# cannot carry DDL. Leave unset when the host has no separate direct endpoint.
DATABASE_URL_DIRECT=
# Separate database used by the test suite; it is truncated between tests.
DATABASE_URL_TEST=postgres://taskeeper:taskeeper@localhost:5433/taskeeper_test
# Connection pool size. Lower toward 1 on serverless, raise on a long-running server.
DATABASE_POOL_MAX=10
# Session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Public origin of the app.
BETTER_AUTH_URL=http://localhost:3000
# App admins by user id, comma-separated — they can manage every account at
# /admin/users. Only needed to bootstrap the first admin; after that, grant the
# role from the admin screen.
AUTH_ADMIN_USER_IDS=
# Sender address. Its domain must be verified in Resend. Use
# "Taskeeper <onboarding@resend.dev>" to test before the domain is verified
# (it only delivers to the Resend account owner's own address).
EMAIL_FROM=
# Invitation and verification email delivery. Leave empty in development to log
# emails (and their links) to the console.
RESEND_API_KEY=
# Pins the runtime clock so every timezone conversion goes through src/lib/dates.ts.
TZ=UTC
